FROM rust:1.86-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p payment-orchestrator

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN useradd -m app
USER app
WORKDIR /app
COPY --from=builder /app/target/release/payment-orchestrator /usr/local/bin/payment-orchestrator
COPY crates/payment-orchestrator/config /app/config
EXPOSE 8091
HEALTHCHECK CMD curl -f http://localhost:8091/health || exit 1
CMD ["payment-orchestrator"]
