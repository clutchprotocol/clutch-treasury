# Treasury secrets — env-only, NEVER in TOML. See docs/keys.md.
APP_MINT_AUTHORITY_SECRET=
APP_INITIATOR_TOKEN=
APP_APPROVER_TOKEN=
APP_READONLY_TOKEN=
APP_TRONGRID_API_KEY=
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5433/treasury

# payment-orchestrator secrets — env-only, NEVER in TOML. Public-zone service: no mint
# authority or approver token, only an initiator (propose) and readonly (read) token
# against the treasury.
APP_JWT_SECRET=
APP_BITCART_TOKEN=
APP_TREASURY_INITIATOR_TOKEN=
APP_TREASURY_READONLY_TOKEN=
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5434/orchestrator
